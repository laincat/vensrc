diff --git a/lib/pages/webview_login.dart b/lib/pages/webview_login.dart
new file mode 100644
index 0000000..8b626eb
--- /dev/null
+++ b/lib/pages/webview_login.dart
@@ -0,0 +1,103 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+import 'package:venera/foundation/comic_source/comic_source.dart';
+import 'package:venera/network/cookie_jar.dart';
+import 'package:venera/network/webview_login_session.dart';
+import 'package:venera/pages/webview.dart';
+
+/// Used by the source login page; cookies never pass through the clipboard.
+class WebviewLoginPage extends StatefulWidget {
+  const WebviewLoginPage({required this.source, this.onStarted, super.key});
+
+  final ComicSource source;
+
+  @visibleForTesting
+  final void Function(InAppWebViewController controller)? onStarted;
+
+  @override
+  State<WebviewLoginPage> createState() => _WebviewLoginPageState();
+}
+
+class _WebviewLoginPageState extends State<WebviewLoginPage> {
+  bool _busy = false;
+  bool _done = false;
+  bool _retry = false;
+
+  Future<void> _capture(InAppWebViewController controller, {bool manual = false}) async {
+    if (_done || !mounted) return;
+    if (_busy) {
+      _retry = true;
+      return;
+    }
+    _busy = true;
+    final source = widget.source;
+    const keys = ['account', 'activeDomain', '_webviewUserAgent', '_localStorage'];
+    final oldData = {
+      for (final key in keys) if (source.data.containsKey(key)) key: source.data[key],
+    };
+    try {
+      final config = source.account!;
+      if (config.onLoginWithWebviewSuccess == null) {
+        throw StateError('当前源没有会员会话校验接口');
+      }
+      final loginUri = Uri.parse(config.loginWebsite!);
+      final current = await controller.getUrl();
+      if (current == null) throw StateError('登录网页尚未就绪');
+      final jar = SingleInstanceCookieJar.instance;
+      if (jar == null) throw StateError('客户端 Cookie 存储尚未就绪');
+      final cookies = await controller.getCookies(current.toString()) ?? [];
+      await verifyWebviewSession(
+        loginUri: loginUri,
+        pageUri: Uri.parse(current.toString()),
+        cookies: cookies,
+        jar: jar,
+        verify: () async {
+          source.data['_webviewUserAgent'] = await controller.getUA();
+          await config.onLoginWithWebviewSuccess!();
+          if (!mounted || ModalRoute.of(context)?.isCurrent != true) {
+            throw StateError('登录页面已关闭，未保存登录状态');
+          }
+          final items = await controller.webStorage.localStorage.getItems();
+          source.data['_localStorage'] = {
+            for (final item in items) if (item.key != null) item.key!: item.value,
+          };
+          source.data['account'] = 'ok';
+          await source.saveData();
+        },
+      );
+      _done = true;
+      if (mounted) Navigator.of(context).pop(true);
+    } catch (_) {
+      for (final key in keys) {
+        if (oldData.containsKey(key)) {
+          source.data[key] = oldData[key];
+        } else {
+          source.data.remove(key);
+        }
+      }
+      await source.saveData();
+      if (manual && mounted) {
+        // Do not display arbitrary source errors that might contain credentials.
+        ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
+          content: Text('会员会话未验证。请先在当前网页完成登录和滑块，然后重试。'),
+        ));
+      }
+    } finally {
+      _busy = false;
+      if (_retry && !_done && mounted) {
+        _retry = false;
+        unawaited(_capture(controller));
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => AppWebview(
+    initialUrl: widget.source.account!.loginWebsite!,
+    onStarted: widget.onStarted,
+    onCaptureCookies: (controller) => _capture(controller, manual: true),
+    onLoadStop: (controller) => unawaited(_capture(controller)),
+  );
+}
