@@ -0,0 +1,141 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_inappwebview/flutter_inappwebview.dart' hide Cookie;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:venera/foundation/app.dart';
+import 'package:venera/foundation/appdata.dart';
+import 'package:venera/foundation/app_page_route.dart';
+import 'package:venera/foundation/comic_source/comic_source.dart';
+import 'package:venera/network/cookie_jar.dart';
+import 'package:venera/pages/webview_login.dart';
+import 'package:venera/utils/translations.dart';
+
+class TestSource implements ComicSource {
+  TestSource(this.account, this.file);
+  @override
+  final AccountConfig account;
+  final File file;
+  @override
+  final Map<String, dynamic> data = {};
+  @override
+  Future<void> saveData() => file.writeAsString(data['account']?.toString() ?? '');
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+
+  testWidgets('native WebView: horizontal slider, HttpOnly capture, verify, persist and return',
+      (tester) async {
+    final directory = await Directory.systemTemp.createTemp('webview-native-');
+    App.dataPath = directory.path;
+    await appdata.init();
+    appdata.settings['proxy'] = 'direct';
+    appdata.settings['language'] = 'en-US';
+    await AppTranslation.init();
+    final jar = SingleInstanceCookieJar('${directory.path}/cookie.db');
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    final origin = 'http://127.0.0.1:${server.port}';
+    var loggedInRequests = 0;
+    server.listen((request) async {
+      request.response.headers.contentType = ContentType.html;
+      if (request.uri.path == '/login') {
+        request.response.write('''<!doctype html><html><head>
+          <meta name="viewport" content="width=device-width,initial-scale=1">
+          <title>Native login fixture</title></head><body style="margin:0">
+          <input id="slider" type="range" value="0" min="0" max="100"
+            style="width:90%;margin-top:160px;height:70px">
+          <a href="/accept">Log in to the local fixture</a></body></html>''');
+      } else if (request.uri.path == '/accept') {
+        request.response.cookies.add(Cookie('fixture_session', 'test-only')
+          ..httpOnly = true..path = '/');
+        // Deliberately return home rather than a magic login URL/title.
+        request.response.headers.set(HttpHeaders.locationHeader, '/home');
+        request.response.statusCode = HttpStatus.seeOther;
+      } else if (request.uri.path == '/member') {
+        if (request.cookies.any((c) => c.name == 'fixture_session' && c.value == 'test-only')) {
+          loggedInRequests++;
+          request.response.write('<a href="/logout">Member verified</a>');
+        } else {
+          request.response.statusCode = HttpStatus.unauthorized;
+          request.response.write('Anonymous');
+        }
+      } else {
+        request.response.write('<title>Home</title>Home');
+      }
+      await request.response.close();
+    });
+    final http = HttpClient();
+    final source = TestSource(AccountConfig(
+      null, '$origin/login', null, () {}, (_, _) => false,
+      () async {
+        final request = await http.getUrl(Uri.parse('$origin/member'));
+        request.headers.set(HttpHeaders.cookieHeader,
+          jar.loadForRequestCookieHeader(Uri.parse('$origin/member')));
+        final response = await request.close();
+        await response.drain<void>();
+        if (response.statusCode != 200) throw StateError('anonymous');
+      },
+      null, null, captureWebviewCookies: true,
+    ), File('${directory.path}/account.txt'));
+    InAppWebViewController? controller;
+    bool? result;
+    await tester.pumpWidget(MaterialApp(
+      home: Builder(builder: (context) => Scaffold(body: TextButton(
+        onPressed: () async {
+          result = await Navigator.of(context).push<bool>(AppPageRoute<bool>(
+            enableIOSGesture: false,
+            builder: (_) => WebviewLoginPage(source: source,
+              onStarted: (value) => controller = value),
+          ));
+        },
+        child: const Text('Open native login'),
+      ))),
+    ));
+    await tester.tap(find.text('Open native login'));
+    for (var i = 0; i < 60; i++) {
+      await tester.pump(const Duration(milliseconds: 250));
+      if (controller != null && await controller!.evaluateJavascript(
+          source: 'document.getElementById("slider") !== null') == true) break;
+    }
+    expect(controller, isNotNull);
+    expect(find.text('获取 Cookie 并登录'), findsOneWidget);
+    final view = tester.getRect(find.byType(InAppWebView));
+    await tester.dragFrom(
+      Offset(view.left + view.width * 0.05, view.top + 195),
+      Offset(view.width * 0.7, 0),
+    );
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(find.byType(WebviewLoginPage), findsOneWidget);
+    final slider = await controller!.evaluateJavascript(
+      source: 'Number(document.getElementById("slider").value)');
+    expect(slider, greaterThan(40));
+    expect(source.data['account'], isNull);
+    await tester.tap(find.text('获取 Cookie 并登录'));
+    await tester.pump(const Duration(seconds: 1));
+    expect(source.data['account'], isNull);
+    expect(find.byType(WebviewLoginPage), findsOneWidget);
+    // This is a test fixture login, not the website CAPTCHA or a real account.
+    await controller!.loadUrl(urlRequest: URLRequest(url: WebUri('$origin/accept')));
+    for (var i = 0; i < 80 && result != true; i++) {
+      await tester.pump(const Duration(milliseconds: 250));
+    }
+    expect(result, isTrue);
+    expect(source.data['account'], 'ok');
+    expect(loggedInRequests, greaterThan(0));
+    expect(await source.file.readAsString(), 'ok');
+    expect(find.byType(WebviewLoginPage), findsNothing);
+    jar.dispose();
+    SingleInstanceCookieJar.instance = null;
+    final reopened = CookieJarSql('${directory.path}/cookie.db');
+    expect(reopened.loadForRequest(Uri.parse('$origin/member')).single.httpOnly, isTrue);
+    reopened.dispose();
+    http.close(force: true);
+    await server.close(force: true);
+    await directory.delete(recursive: true);
+  });
+}
