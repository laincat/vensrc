@@ -0,0 +1,64 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:venera/network/cookie_jar.dart';
+import 'package:venera/network/webview_login_session.dart';
+
+void main() {
+  late Directory directory;
+  late CookieJarSql jar;
+  final uri = Uri.parse('https://login.example.test/users-index.html');
+  setUp(() {
+    directory = Directory.systemTemp.createTempSync('webview-session-');
+    jar = CookieJarSql('${directory.path}/cookies.db');
+  });
+  tearDown(() {
+    jar.dispose();
+    directory.deleteSync(recursive: true);
+  });
+
+  test('waits for verification and persists an HttpOnly cookie across restart', () async {
+    var accepted = false;
+    await verifyWebviewSession(
+      loginUri: uri, pageUri: uri, jar: jar,
+      cookies: [Cookie('session', 'test-only')..httpOnly = true..path = '/'],
+      verify: () async {
+        await Future<void>.delayed(const Duration(milliseconds: 20));
+        expect(jar.loadForRequestCookieHeader(uri), 'session=test-only');
+        accepted = true;
+      },
+    );
+    expect(accepted, isTrue);
+    jar.dispose();
+    jar = CookieJarSql('${directory.path}/cookies.db');
+    expect(jar.loadForRequest(uri).single.httpOnly, isTrue);
+  });
+
+  test('rejected login restores unrelated paths and removes imported cookies', () async {
+    jar.saveFromResponse(uri, [
+      Cookie('previous', 'root')..path = '/',
+      Cookie('nested', 'keep')..path = '/other',
+    ]);
+    await expectLater(verifyWebviewSession(
+      loginUri: uri, pageUri: uri, jar: jar,
+      cookies: [Cookie('session', 'invalid')..path = '/'],
+      verify: () async => throw StateError('anonymous'),
+    ), throwsStateError);
+    expect(jar.loadForRequestCookieHeader(uri), 'previous=root');
+    expect(jar.loadForRequestCookieHeader(uri.resolve('/other')), contains('nested=keep'));
+  });
+
+  test('foreign page and empty cookies cannot trigger verification', () async {
+    for (final page in [
+      Uri.parse('https://untrusted.test/'),
+      Uri.parse('http://login.example.test/'),
+      uri.replace(userInfo: 'fixture-user'),
+      uri,
+    ]) {
