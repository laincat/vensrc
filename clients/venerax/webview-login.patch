diff --git a/lib/network/webview_login_session.dart b/lib/network/webview_login_session.dart
new file mode 100644
index 0000000..338a142
--- /dev/null
+++ b/lib/network/webview_login_session.dart
@@ -0,0 +1,32 @@
+import 'dart:io';
+
+import 'package:venera/network/cookie_jar.dart';
+
+/// Verify through the application's HTTP client, including HttpOnly cookies.
+/// Failed verification restores all cookie paths, not just the current page.
+Future<void> verifyWebviewSession({
+  required Uri loginUri,
+  required Uri pageUri,
+  required List<Cookie> cookies,
+  required CookieJarSql jar,
+  required Future<void> Function() verify,
+}) async {
+  if (loginUri.origin != pageUri.origin || pageUri.userInfo.isNotEmpty) {
+    throw StateError('登录页已跳到其他站点，请返回原登录域名');
+  }
+  final accepted = cookies.where((cookie) {
+    final domain = (cookie.domain ?? pageUri.host).replaceFirst(RegExp(r'^\.'), '');
+    return domain.isNotEmpty &&
+        (domain == pageUri.host || pageUri.host.endsWith('.$domain'));
+  }).toList();
+  if (accepted.isEmpty) throw StateError('网页尚未取得会话，请先完成登录和滑块');
+  final previous = jar.snapshotForDomain(loginUri);
+  try {
+    jar.saveFromResponse(pageUri, accepted);
+    await verify();
+  } catch (_) {
+    jar.deleteUri(loginUri);
+    jar.saveFromResponse(loginUri, previous);
+    rethrow;
+  }
+}
